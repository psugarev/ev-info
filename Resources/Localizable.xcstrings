    "Each cell is about 3.7 V nominal. The BMS reports up to 192 cells in six blocks of 32, and balances them so they age evenly." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всяка клетка е около 3.7V номинално. BMS показва до 192 клетки в шест блока по 32 и ги балансира, за да стареят равномерно."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each cell is about 3.7 V nominal. The BMS reports up to 192 cells in six blocks of 32, and balances them so they age evenly."
          }
        }
      }
    },
