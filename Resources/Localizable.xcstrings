        }
      }
    },
    "Do not operate or read the app while driving. Let a passenger use it, or stop in a safe place." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do not operate or read the app while driving. Let a passenger use it, or stop in a safe place."
          }
