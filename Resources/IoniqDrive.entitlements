<plist version="1.0">
<dict>
    <!-- No special entitlements needed for CoreBluetooth central on iOS.
         Background BLE is declared via UIBackgroundModes in Info.plist.
         CarPlay would require com.apple.developer.carplay-* entitlements when added. -->
</dict>
</plist>
